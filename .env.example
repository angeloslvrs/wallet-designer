# Cert profile selector — dev (default) or prod
CERT_PROFILE=dev

# Apple-issued in prod; arbitrary in dev
PASS_TYPE_ID=pass.dev.local
TEAM_ID=DEV0000000

# Organization shown on pass
ORG_NAME=Rocket Partners Airlines

# Server port
PORT=4317
VITE_PORT=4318

# Prod: pin X-Forwarded-For trust to the reverse proxy's address (IP or CIDR,
# comma-separated). Unset = trust 1 hop (any immediate peer) — fine for dev.
# TRUST_PROXY=10.1.2.154

# Private key passphrase (optional)
# KEY_PASSPHRASE=
