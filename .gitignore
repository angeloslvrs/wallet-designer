node_modules/
dist/
.env
.env.local
*.log

# certs — never commit signing material
certs/dev/*
certs/prod/*
!certs/dev/.gitkeep
!certs/prod/.gitkeep

# build artifacts
*.pkpass
out/

.DS_Store

# generated placeholder pass images from `npm run init` (root only — the
# designer's committed static assets live in apps/designer/src/assets/)
/assets/

# dev-sample template images are generated by `npm run init` (gen-assets);
# only its pass.json is committed
templates/dev-sample.pkpasstemplate/*.png

state/

# operator-saved Studio designs and routes (user data, like state/)
designs/
/routes/

.superpowers/

# Claude Code: ignore ephemeral/personal artifacts; shared config
# (settings.json, commands/, agents/) can still be committed intentionally
.claude/plans/
.claude/settings.local.json
.claude/*.local.json
